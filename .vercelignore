# Vercel Ignore File
# Files and directories to exclude from Vercel deployment

# Development files
.env.local
.env.development
.env.test

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/

# Build artifacts (Vercel handles these)
.next/
out/
dist/

# Documentation
docs/
*.md
!README.md

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Render-specific files (not needed for Vercel)
render.yaml
build-render.sh
.env.render
DEPLOY_RENDER.md

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary folders
tmp/
temp/