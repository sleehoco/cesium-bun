# Vercel Environment Variables Template
# Copy these to your Vercel project settings

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=@app_url
NEXT_PUBLIC_VERCEL_ENV=@vercel_env

# Authentication (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database (Vercel Postgres)
POSTGRES_URL=@postgres_url
POSTGRES_PRISMA_URL=@postgres_prisma_url
POSTGRES_URL_NON_POOLING=@postgres_url_non_pooling

# AI Services
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
TOGETHER_AI_API_KEY=your_together_ai_api_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_id
VERCEL_ANALYTICS_ID=@vercel_analytics_id

# Security
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=@app_url

# Development
NEXT_PUBLIC_DEBUG=false

# Vercel-specific (auto-populated)
VERCEL=@vercel
VERCEL_ENV=@vercel_env
VERCEL_URL=@vercel_url
VERCEL_GIT_COMMIT_SHA=@vercel_git_commit_sha
VERCEL_GIT_COMMIT_MESSAGE=@vercel_git_commit_message
VERCEL_GIT_COMMIT_REF=@vercel_git_commit_ref
VERCEL_GIT_REPO_SLUG=@vercel_git_repo_slug
VERCEL_GIT_REPO_OWNER=@vercel_git_repo_owner